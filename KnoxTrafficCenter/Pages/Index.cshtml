@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@if (Model.Incidents.Any() == true)
{
    <div class="alert alert-danger text-center mb-4" role="alert">
        <button class="btn btn-link text-dark fw-bold p-0" type="button" data-bs-toggle="collapse" data-bs-target="#incidentsCollapse" aria-expanded="true" aria-controls="incidentsCollapse">
            Traffic Incidents <span id="incidentsChevron" class="bi bi-chevron-up"></span>
        </button>
        <div class="collapse show mt-2" id="incidentsCollapse">
            <ul class="list-unstyled mb-0">
                @foreach (var incident in Model.Incidents)
                {
                    <li class="mb-2">@incident.Description</li>
                }
            </ul>
        </div>
    </div>
}

@if (Model.ConstructionEvents.Any() == true)
{
    <div class="alert alert-warning text-center mb-4" role="alert">
        <button class="btn btn-link text-dark fw-bold p-0" type="button" data-bs-toggle="collapse" data-bs-target="#constructionCollapse" aria-expanded="true" aria-controls="constructionCollapse">
            Construction <span id="constructionChevron" class="bi bi-chevron-down"></span>
        </button>
        <div class="collapse hide mt-2" id="constructionCollapse">
            <ul class="list-unstyled mb-0">
                @foreach (var constructionEvent in Model.ConstructionEvents)
                {
                    <li class="mb-2">@constructionEvent.Description</li>
                }
            </ul>
        </div>
    </div>
}

<div class="row">
    @foreach (var camera in Model.Cameras)
    {
        <div class="col-12 col-md-6 col-lg-4 col-xl-3 col-xxl-2 g-1">
            <div class="card p-2">
                <h4 class="card-title">
                    @camera.Title
                </h4>

                @if (camera.MM is not null)
                {
                    <h6 class="text-muted card-subtitle">MM @camera.MM</h6>
                }
                <a href="#" data-bs-toggle="modal" data-bs-target="#videoModal" data-bs-title="@camera.Road @camera.Location @camera.Title" data-bs-video-url="@(camera.Video.URL)">
                    <img src="@camera.Image.URL" class="card-img-bottom rounded img-fluid" alt="camera image of @camera.Road @camera.Location @camera.Title" loading="lazy" />
                </a>
            </div>
        </div>
    }
</div>

<div class="modal fade" tabindex="-1" id="videoModal">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Modal title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
            </div>
        </div>
    </div>
</div>

<script src="~/js/modal.js" type="text/javascript" asp-append-version="true"></script>
<script type="text/javascript">
    var videoModal = document.getElementById('videoModal');
    videoModal.addEventListener('show.bs.modal', ShowModal);
    videoModal.addEventListener('hide.bs.modal', HideModal);
</script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var incidentsCollapse = document.getElementById('incidentsCollapse');
        var incidentsChevron = document.getElementById('incidentsChevron');
        if (incidentsCollapse && incidentsChevron) {
            incidentsCollapse.addEventListener('show.bs.incidentsCollapse', function () {
                incidentsChevron.classList.remove('bi-chevron-down');
                incidentsChevron.classList.add('bi-chevron-up');
            });
            incidentsCollapse.addEventListener('hide.bs.incidentsCollapse', function () {
                incidentsChevron.classList.remove('bi-chevron-up');
                incidentsChevron.classList.add('bi-chevron-down');
            });
        }
    });

    document.addEventListener('DOMContentLoaded', function () {
        var constructionCollapse = document.getElementById('constructionCollapse');
        var constructionChevron = document.getElementById('constructionChevron');
        if (constructionCollapse && constructionChevron) {
            constructionCollapse.addEventListener('show.bs.collapse', function () {
                constructionChevron.classList.remove('bi-chevron-down');
                constructionChevron.classList.add('bi-chevron-up');
            });
            constructionCollapse.addEventListener('hide.bs.collapse', function () {
                constructionChevron.classList.remove('bi-chevron-up');
                constructionChevron.classList.add('bi-chevron-down');
            });
        }
    });
</script>
