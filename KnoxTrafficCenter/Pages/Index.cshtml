@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<partial name="_IncidentsAlerts" model="Model" />

<div id="weatherAlertsSection">
    <partial name="_WeatherAlerts" model="Model" />
</div>

<partial name="_ConstructionAlerts" model="Model" />

<div class="row">
    @foreach (var group in Model.CameraGroups)
    {
        <div class="col-12">
            <h2 class="mt-4 mb-3 fw-bold border-bottom pb-2 text-info">
                @group.Title
            </h2>
        </div>
        @foreach (var camera in group.Cameras)
        {
            <div class="col-12 col-md-6 col-lg-4 col-xl-3 col-xxl-2 g-1">
                <div class="card border border-info">
                    <div class="card-body">
                        <h5 class="card-title">
                            @camera.Title
                        </h5>
                        @if (camera.MM is not null)
                        {
                            <h6 class="text-muted card-subtitle">MM @camera.MM</h6>
                        }
                    </div>
                    <a href="#" data-bs-toggle="modal" data-bs-target="#videoModal" data-bs-title="@camera.Title" data-bs-video-url="@(camera.Video.URL)">
                        <img src="@camera.Image.URL" class="card-img-bottom img-fluid" alt="camera image of @camera.Title" loading="lazy" />
                    </a>
                </div>
            </div>
        }
    }
</div>

<div class="modal fade" tabindex="-1" id="videoModal">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Modal title</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
            </div>
        </div>
    </div>
</div>

<script src="~/js/modal.js" type="text/javascript" asp-append-version="true"></script>
<script type="text/javascript">
    var videoModal = document.getElementById('videoModal');
    videoModal.addEventListener('show.bs.modal', ShowModal);
    videoModal.addEventListener('hide.bs.modal', HideModal);
</script>
