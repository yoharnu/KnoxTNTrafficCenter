@model IndexModel
@{
    var hasWeatherAlerts = Model.WeatherEvents.Any() || Model.CountyWideWeatherEvents.Any();
}

@if (hasWeatherAlerts)
{
    <div class="alert alert-info text-center mb-4" role="alert" id="weather-alerts-container">
        <h6 class="fw-bold p-0" data-bs-toggle="collapse" data-bs-target="#weatherCollapse" aria-expanded="true" aria-controls="weatherCollapse">
            <span class="bi bi-cloud-lightning-rain"></span> Weather Alerts for Knox County <span id="weatherChevron" class="bi bi-chevron-up"></span>
        </h6>
        <div class="collapse show mt-2" id="weatherCollapse">
            <ul class="list-unstyled mb-0">
                @foreach (var weather in Model.WeatherEvents)
                {
                    <li class="mb-2 weather-alert">
                        <span class="badge bg-info">TDOT Alert</span>
                        @weather.Description
                    </li>
                }
                @foreach (var countyWeather in Model.CountyWideWeatherEvents)
                {
                    <li class="mb-2 weather-alert">
                        <span class="badge bg-primary">County Alert</span>
                        @countyWeather.Description
                    </li>
                }
            </ul>
            <div class="text-end small text-muted mt-2">
                <span id="last-updated-time">Last updated: @DateTime.Now.ToString("h:mm:ss tt")</span>
            </div>
        </div>
    </div>
}
else
{
    <div id="weather-alerts-container" style="display: none;"></div>
}
